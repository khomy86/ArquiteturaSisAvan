# Copy to .env and change the values. Every variable has a development default
# in docker-compose.yml, so the stack also starts without this file.

# Host port for the nginx entry point. Rootless Podman can't bind ports below 1024.
HTTP_PORT=8080

# Admin panel login. Changing the password here and restarting the catalog
# services updates the stored password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs admin session tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

POSTGRES_PASSWORD=ualflix
REPLICATION_PASSWORD=replicator

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
